{
  "info": {
    "name": "GitHub Profile Analyzer API",
    "description": "Postman collection for the GitHub Profile Analyzer assignment API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "octocat"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Analyze GitHub Profile",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/analyze/{{username}}"
      }
    },
    {
      "name": "Get All Profiles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/profiles"
      }
    },
    {
      "name": "Get Single Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/profiles/{{username}}"
      }
    },
    {
      "name": "Get Profile Repos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/profiles/{{username}}/repos"
      }
    },
    {
      "name": "Delete Profile",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/profiles/{{username}}"
      }
    }
  ]
}
